# --- Path Resolution ---
resolve_paths() {
    if [[ -n "${CYBERRANGE_DIR:-}" && -f "$CYBERRANGE_DIR/docker-compose.yml" ]]; then
        LAB_DIR="$CYBERRANGE_DIR"
    elif [[ -f "/etc/cyberrange/lab_path" ]] && [[ -f "$(cat /etc/cyberrange/lab_path 2>/dev/null)/docker-compose.yml" ]]; then
        LAB_DIR="$(cat /etc/cyberrange/lab_path)"
    else
        local source="${BASH_SOURCE[0]}"
        while [ -h "$source" ]; do
            local dir="$(cd -P "$(dirname "$source")" && pwd)"
            source="$(readlink "$source")"
            [[ $source != /* ]] && source="$dir/$source"
        done
        local script_dir="$(cd -P "$(dirname "$source")" && pwd)"
        
        if [[ -f "$script_dir/docker-compose.yml" ]]; then
            LAB_DIR="$script_dir"
        elif [[ -f "$script_dir/Cyberrange_Programfiles/docker-compose.yml" ]]; then
            LAB_DIR="$script_dir/Cyberrange_Programfiles"
        elif [[ -f "/home/cyberrange/CyberRange/Cyberrange_Programfiles/docker-compose.yml" ]]; then
            LAB_DIR="/home/cyberrange/CyberRange/Cyberrange_Programfiles"
        elif [[ -f "/opt/cyberrange/Cyberrange_Programfiles/docker-compose.yml" ]]; then
            LAB_DIR="/opt/cyberrange/Cyberrange_Programfiles"
        elif [[ -f "./docker-compose.yml" ]]; then
            LAB_DIR="$(pwd)"
        elif [[ -f "./Cyberrange_Programfiles/docker-compose.yml" ]]; then
            LAB_DIR="$(pwd)/Cyberrange_Programfiles"
        else
            LAB_DIR="/home/cyberrange/CyberRange/Cyberrange_Programfiles"
        fi
    fi
    DASHBOARD_DIR="$LAB_DIR/dashboard"
}

# --- Bulletproof IP Detection ---
detect_ip() {
    local ip=""
    # Method 1: Default routing table source IP
    ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' || true)
    
    # Method 2: ens33 interface (VMware primary default)
    if [[ -z "$ip" || "$ip" =~ ^169\.254 ]]; then
        ip=$(ip -4 addr show ens33 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || true)
    fi
    
    # Method 3: First valid non-loopback, non-docker physical interface
    if [[ -z "$ip" || "$ip" =~ ^169\.254 ]]; then
        for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -v 'lo\|docker\|br-\|veth'); do
            local cand
            cand=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || true)
            if [[ -n "$cand" && ! "$cand" =~ ^169\.254 && ! "$cand" =~ ^127\. ]]; then
                ip="$cand"
                break
            fi
        done
    fi
    
    # Method 4: hostname -I
    if [[ -z "$ip" || "$ip" =~ ^169\.254 ]]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    fi
    
    # Method 5: Fallback to localhost
    if [[ -z "$ip" || "$ip" =~ ^169\.254 ]]; then
        ip="127.0.0.1"
    fi
    
    echo "$ip"
}

# --- Docker Compose Command Finder ---
get_docker_compose() {
    if docker compose version &>/dev/null; then
        echo "docker compose"
    elif command -v docker-compose &>/dev/null; then
        echo "docker-compose"
    else
        echo ""
    fi
}

