# --- Main Dispatcher ---
main() {
    case "${1:-}" in
        start)
            cmd_start "${2:-}"
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        fix)
            cmd_fix
            ;;
        reset)
            cmd_reset
            ;;
        banner|info)
            cmd_banner
            ;;
        autostart)
            cmd_autostart "${2:-status}"
            ;;
        version|-v|--version)
            echo -e "${NEON_CYAN}CyberRange 2.0 (Elite Edition)${NC}"
            ;;
        help|-h|--help|"")
            cmd_help
            ;;
        *)
            echo -e "${RED}[!] Unknown command: $1${NC}"
            echo -e "${YELLOW}Run 'cyberrange help' for a list of available commands.${NC}"
            exit 1
            ;;
    esac
}

main "$@"
