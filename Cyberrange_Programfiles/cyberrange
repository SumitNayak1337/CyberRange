    echo -e "    ${NEON_CYAN}stop${NC}        Stop all lab containers and terminate web server"
    echo -e "    ${NEON_CYAN}restart${NC}     Perform a clean stop and start cycle"
    echo -e "    ${NEON_CYAN}status${NC}      Display live container health, open ports, and system metrics"
    echo -e "    ${NEON_CYAN}fix${NC}         Auto-diagnose & repair Docker, LVM disk, logs, and port conflicts"
    echo -e "    ${NEON_CYAN}reset${NC}       Wipe all lab data, volumes, logs, and perform a fresh restart"
    echo -e "    ${NEON_CYAN}banner${NC}      Display the aesthetic ASCII Magic splash screen and endpoints"
    echo -e "    ${NEON_CYAN}autostart${NC}   Manage boot auto-start: [enable | disable | status]"
    echo -e "    ${NEON_CYAN}version${NC}     Display CyberRange version\n"
