# --- Command: START ---
cmd_start() {
    resolve_paths
    local ip
    ip=$(detect_ip)
    
    # Check Docker installation
    if ! command -v docker &>/dev/null; then
        echo -e "${RED}[!] Error: Docker is not installed.${NC}"
        echo -e "${YELLOW}[*] Run 'sudo cyberrange fix' or 'sudo ./install.sh' to install Docker.${NC}"
        exit 1
    fi
    
    # Start Docker service if inactive
    if ! docker info &>/dev/null; then
        echo -e "${YELLOW}[*] Docker daemon is not active. Starting docker service...${NC}"
        sudo systemctl start docker || true
        sleep 2
    fi
    
    local compose_cmd
    compose_cmd=$(get_docker_compose)
    if [[ -z "$compose_cmd" ]]; then
        echo -e "${RED}[!] Error: Neither 'docker compose' nor 'docker-compose' found.${NC}"
        exit 1
    fi
    
    if [[ ! -f "$LAB_DIR/docker-compose.yml" ]]; then
        echo -e "${RED}[!] Error: docker-compose.yml not found in $LAB_DIR.${NC}"
        exit 1
    fi
    
    # Kill any dangling server on port 9000
    pkill -f "python3 -m http.server 9000" 2>/dev/null || true
    if command -v fuser &>/dev/null; then
        fuser -k 9000/tcp 2>/dev/null || true
    fi
    
    # Generate dashboard
    echo -e "${NEON_AQUA}[*] Generating CyberRange 2.0 Web Dashboard for IP ${BOLD}${ip}${NC}..."
    generate_dashboard "$ip"
    
    # Launch containers
    echo -e "${NEON_AQUA}[*] Launching containers via ${compose_cmd}...${NC}"
    (cd "$LAB_DIR" && $compose_cmd up -d)
    
    # Launch Web Server on port 9000
    echo -e "${NEON_AQUA}[*] Starting Web Dashboard server on port 9000...${NC}"
    mkdir -p "$DASHBOARD_DIR"
    nohup python3 -m http.server 9000 --directory "$DASHBOARD_DIR" >/dev/null 2>&1 &
    
    sleep 1
    
    # Display ASCII Magic & Quick links
    if [[ "${1:-}" != "--quiet" ]]; then
        show_banner
        show_dashboard_card "$ip"
    fi
}

# --- Command: STOP ---
cmd_stop() {
    resolve_paths
    local compose_cmd
    compose_cmd=$(get_docker_compose)
    
    echo -e "${NEON_CYAN}[*] Stopping CyberRange Docker containers...${NC}"
    if [[ -n "$compose_cmd" && -f "$LAB_DIR/docker-compose.yml" ]]; then
        (cd "$LAB_DIR" && $compose_cmd down 2>/dev/null || true)
    fi
    
    echo -e "${NEON_CYAN}[*] Terminating Dashboard HTTP Server (Port 9000)...${NC}"
    pkill -f "python3 -m http.server 9000" 2>/dev/null || true
    if command -v fuser &>/dev/null; then
        fuser -k 9000/tcp 2>/dev/null || true
    fi
    
    echo -e "${ELECTRIC_GREEN}[✓] CyberRange 2.0 Lab stopped successfully.${NC}"
}

# --- Command: RESTART ---
cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

# --- Command: STATUS ---
cmd_status() {
    resolve_paths
    local ip
    ip=$(detect_ip)
    
    show_banner
    echo -e "  ${WHITE}${BOLD}SYSTEM DIAGNOSTICS & HEALTH CHECK${NC}"
    echo -e "  ${MUTED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    # Check Docker Daemon
    if docker info &>/dev/null; then
        echo -e "  [✓] Docker Daemon    : ${BRIGHT_GREEN}RUNNING${NC}"
    else
        echo -e "  [✗] Docker Daemon    : ${RED}STOPPED${NC} (Run 'cyberrange fix')"
    fi
    
    # Containers Check
    local containers=("cyberrange_dvwa" "cyberrange_juice" "cyberrange_splunk" "cyberrange_suricata")
    for c in "${containers[@]}"; do
        local status
        status=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "not running")
        if [[ "$status" == "running" ]]; then
            echo -e "  [✓] Container ${WHITE}$c${NC} : ${BRIGHT_GREEN}UP (running)${NC}"
        else
            echo -e "  [✗] Container ${WHITE}$c${NC} : ${RED}$status${NC}"
        fi
    done
    
    # Dashboard check
    if pgrep -f "python3 -m http.server 9000" &>/dev/null; then
        echo -e "  [✓] Web Dashboard    : ${BRIGHT_GREEN}ACTIVE (Port 9000)${NC}"
    else
        echo -e "  [✗] Web Dashboard    : ${YELLOW}OFFLINE${NC}"
    fi
    
    # Autostart check
    local auto_status="disabled"
    if systemctl is-enabled cyberrange.service &>/dev/null; then
        auto_status="${BRIGHT_GREEN}ENABLED (Boot on startup)${NC}"
    else
        auto_status="${YELLOW}DISABLED${NC} (Enable via 'cyberrange autostart enable')"
    fi
    echo -e "  [•] Auto-Start       : $auto_status"
    
    # System Resources
    echo -e "  ${MUTED}────────────────────────────────────────────────────────────${NC}"
    local mem_usage
    mem_usage=$(free -h 2>/dev/null | awk '/Mem:/ {print $3 "/" $2}' || echo "N/A")
    local disk_usage
    disk_usage=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}' || echo "N/A")
    echo -e "  [•] Memory In Use    : ${WHITE}$mem_usage${NC}"
    echo -e "  [•] Root Disk In Use : ${WHITE}$disk_usage${NC}"
    
    show_dashboard_card "$ip"
}

# --- Command: FIX (Self-Healing Engine) ---
cmd_fix() {
    resolve_paths
    show_banner
    echo -e "${GOLD}${BOLD}[*] INITIATING CYBERRANGE 2.0 AUTOMATED REPAIR & DIAGNOSTICS...${NC}\n"
    
    # 1. Check Root / Sudo
    echo -e "${WHITE}[1/7] Checking Permissions...${NC}"
    local is_root=false
    if [[ $EUID -eq 0 ]]; then
        is_root=true
        echo -e "      ${BRIGHT_GREEN}[✓] Running with administrative privileges.${NC}"
    else
        echo -e "      ${YELLOW}[!] Note: Running as standard user. Sudo will be requested when needed.${NC}"
    fi
    
    # 2. Fix Docker Daemon
    echo -e "${WHITE}[2/7] Checking Docker Engine...${NC}"
    if ! docker info &>/dev/null; then
        echo -e "      ${YELLOW}[*] Restarting Docker service...${NC}"
        sudo systemctl restart docker || true
        sleep 3
    fi
    if docker info &>/dev/null; then
        echo -e "      ${BRIGHT_GREEN}[✓] Docker Engine is healthy.${NC}"
    else
        echo -e "      ${RED}[✗] Failed to start Docker. Check 'sudo journalctl -u docker'.${NC}"
    fi
    
    # 3. Check & Expand Disk / Clean Space
    echo -e "${WHITE}[3/7] Optimizing Storage & Expanding Disk...${NC}"
    # Expand LVM if available
    local root_lv
    root_lv=$(df / | tail -1 | awk '{print $1}')
    if [[ "$root_lv" == *"/dev/mapper/"* ]]; then
        echo -e "      ${NEON_AQUA}[*] LVM Partition detected ($root_lv). Reclaiming 100% free space...${NC}"
        sudo lvextend -l +100%FREE "$root_lv" 2>/dev/null || true
        sudo resize2fs "$root_lv" 2>/dev/null || true
    fi
    
    # Truncate runaway Docker logs
    echo -e "      ${NEON_AQUA}[*] Truncating oversized Docker log files...${NC}"
    sudo sh -c 'truncate -s 0 /var/lib/docker/containers/*/*-json.log 2>/dev/null' || true
    
    # Prune dangling Docker items
    echo -e "      ${NEON_AQUA}[*] Pruning unused Docker build cache & dangling networks...${NC}"
    docker system prune -f 2>/dev/null || true
    echo -e "      ${BRIGHT_GREEN}[✓] Storage optimization complete.${NC}"
    
    # 4. Port Conflicts & Orphaned Processes
    echo -e "${WHITE}[4/7] Checking & Resolving Port Conflicts...${NC}"
    pkill -f "python3 -m http.server 9000" 2>/dev/null || true
    if command -v fuser &>/dev/null; then
        sudo fuser -k 9000/tcp 2>/dev/null || true
    fi
    echo -e "      ${BRIGHT_GREEN}[✓] Port 9000 cleared for Dashboard.${NC}"
    
    # 5. Fix Directory & Suricata Permissions
    echo -e "${WHITE}[5/7] Verifying System Permissions & Log Dirs...${NC}"
    sudo mkdir -p /var/log/suricata
    sudo chmod -R 777 /var/log/suricata
    if [[ -d "$LAB_DIR" ]]; then
        chmod +x "$LAB_DIR"/*.sh 2>/dev/null || true
    fi
    echo -e "      ${BRIGHT_GREEN}[✓] Suricata log directory permissions granted.${NC}"
    
    # 6. Ensure Systemd Autostart Service is Installed
    echo -e "${WHITE}[6/7] Verifying Systemd Autostart Configuration...${NC}"
    if [[ -f "$LAB_DIR/cyberrange.service" ]]; then
        sudo cp "$LAB_DIR/cyberrange.service" /etc/systemd/system/cyberrange.service
        sudo systemctl daemon-reload
        sudo systemctl enable cyberrange.service 2>/dev/null || true
        echo -e "      ${BRIGHT_GREEN}[✓] Cyberrange autostart on boot is active.${NC}"
    fi
    
    # 7. Restart Lab & Verify Endpoints
    echo -e "${WHITE}[7/7] Re-initializing Lab Services...${NC}"
    cmd_start
    
    echo -e "\n${BRIGHT_GREEN}${BOLD}[✓] REPAIR COMPLETE: All CyberRange 2.0 subsystems checked and stabilized!${NC}\n"
}

# --- Command: RESET ---
cmd_reset() {
    resolve_paths
    echo -e "${NEON_RED}${BOLD}⚠️  WARNING: Resetting will destroy container states, volumes, and reset all logs!${NC}"
    read -rp "Are you sure you want to completely reset CyberRange? (y/N): " confirm
    if [[ "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
        echo -e "${YELLOW}[*] Wiping containers and volumes...${NC}"
        local compose_cmd
        compose_cmd=$(get_docker_compose)
        if [[ -n "$compose_cmd" && -f "$LAB_DIR/docker-compose.yml" ]]; then
            (cd "$LAB_DIR" && $compose_cmd down -v)
        fi
        
        echo -e "${YELLOW}[*] Wiping Suricata logs...${NC}"
        sudo rm -rf /var/log/suricata/* 2>/dev/null || true
        
        echo -e "${YELLOW}[*] Truncating Docker logs...${NC}"
        sudo sh -c 'truncate -s 0 /var/lib/docker/containers/*/*-json.log 2>/dev/null' || true
        
        echo -e "${YELLOW}[*] Purging Docker system cache...${NC}"
        docker system prune -f
        docker volume prune -a -f
        
        echo -e "${BRIGHT_GREEN}[✓] Clean reset complete. Re-launching CyberRange...${NC}"
        cmd_start
    else
        echo -e "${MUTED}Reset cancelled.${NC}"
    fi
}

# --- Command: AUTOSTART ---
cmd_autostart() {
    resolve_paths
    local action="${1:-status}"
    case "$action" in
        enable)
            if [[ -f "$LAB_DIR/cyberrange.service" ]]; then
                sudo cp "$LAB_DIR/cyberrange.service" /etc/systemd/system/cyberrange.service
                sudo systemctl daemon-reload
                sudo systemctl enable cyberrange.service
                echo -e "${BRIGHT_GREEN}[✓] CyberRange 2.0 autostart on machine boot has been ENABLED.${NC}"
            else
                echo -e "${RED}[!] cyberrange.service file not found in $LAB_DIR.${NC}"
            fi
            ;;
        disable)
            sudo systemctl disable cyberrange.service
            echo -e "${YELLOW}[*] CyberRange 2.0 autostart on machine boot has been DISABLED.${NC}"
            ;;
        status)
            echo -e "${WHITE}Systemd Autostart Status:${NC}"
            systemctl status cyberrange.service --no-pager || true
            ;;
        *)
            echo "Usage: cyberrange autostart [enable|disable|status]"
            ;;
    esac
}

